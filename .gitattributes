# Normalize line endings: store as LF in the repo, check out as LF everywhere.
# Prevents CRLF/LF churn when the repo is edited on Windows.
* text=auto eol=lf

# Explicitly binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
